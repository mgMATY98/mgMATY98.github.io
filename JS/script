// Obtenemos los elementos
const boton = document.getElementById("cambiar-modo");
const mainContent = document.getElementById("main-content");

// Función para alternar modo
function alternarModo() {
    if (mainContent.classList.contains('modo-obscuro')) {
        mainContent.classList.remove('modo-obscuro');
        mainContent.classList.add('modo-claro');
        boton.style.backgroundImage = "url('../Imagenes/sun.png')"; // imagen de sol
    } else {
        mainContent.classList.remove('modo-claro');
        mainContent.classList.add('modo-obscuro');
        boton.style.backgroundImage = "url('../Imagenes/night-mode.png')";
    }
}

// Evento click
boton.addEventListener('click', alternarModo);

// Opcional: Guardar preferencia del usuario
if (localStorage.getItem('modo') === 'claro') {
    mainContent.classList.remove('modo-obscuro');
    mainContent.classList.add('modo-claro');
    boton.style.backgroundImage = "url('../Imagenes/sun.png')";
}
